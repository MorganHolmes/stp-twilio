{
  "$schema": "https://raw.githubusercontent.com/zingdevlimited/actions-helpers/v3/.schemas/documentation-validator.json",
  "sources": [
    {
      "id": "api-env-sample",
      "format": "env",
      "file": "workspaces/api/.env.sample",
      "ignore-list": [
        "ACCOUNT_SID",
        "AUTH_TOKEN"
      ]
    },
    {
      "id": "api-context-ts",
      "format": "typescript",
      "file": "workspaces/api/src/types/index.ts",
      "typescript:declaration-name": "BaseContext",
      "ignore-list": [
        "ACCOUNT_SID",
        "AUTH_TOKEN"
      ]
    },
    {
      "id": "deploy-api-vars-yaml",
      "format": "yaml",
      "file": ".github/workflows/deploy.yaml",
      "yaml:path": "jobs.configure_twilio.steps.[id=updateFunctionVariables].with.VARIABLES_ENV",
      "yaml:subformat": "env"
    },
    {
      "id": "plugin-env-sample",
      "format": "env",
      "file": "workspaces/plugin/.env.sample",
      "ignore-list": [
        "FLEX_APP_LOCAL_DEV",
        "FLEX_APP_DEBUG"
      ]
    },
    {
      "id": "deploy-plugin-config-yaml",
      "format": "yaml",
      "file": ".github/workflows/deploy.yaml",
      "yaml:path": "jobs.configure_twilio.steps.[id=updatePluginConfig].with.CONFIG_DATA_JSON",
      "yaml:subformat": "json"
    },
    {
      "id": "gh-vars-secrets",
      "format": "github-workflow",
      "file": ".github/workflows/deploy.yaml",
      "github-workflow:format-replace": [
        {
          "expression": "inputs.ENVIRONMENT",
          "value": "PRODUCTION"
        }
      ],
      "ignore-prefix": "GITHUB_"
    },
    {
      "id": "vars-secrets-table-md",
      "format": "markdown-table",
      "file": "docs/deployment/deployment-guide.md",
      "markdown-table:section-heading": "### Required Variables/Secrets",
      "markdown-table:table-header": "| Name | Description | Is Secret | Note |",
      "markdown-table:column-number": 1
    }
  ],
  "validations": [
    {
      "description": "All API Context variables should be in .env.sample",
      "source": "api-context-ts",
      "target": "api-env-sample"
    },
    {
      "description": "API Context variables should exactly match deployed variables",
      "source": "api-context-ts",
      "target": "deploy-api-vars-yaml",
      "symmetric": true
    },
    {
      "description": "Plugin .env.sample variables should exactly match deployed config",
      "source": "plugin-env-sample",
      "target": "deploy-plugin-config-yaml",
      "symmetric": true
    },
    {
      "description": "All GH Vars/Secrets used in Deployment should be documented",
      "source": "gh-vars-secrets",
      "target": "vars-secrets-table-md",
      "symmetric": true
    }
  ]
}