{
  "name": "stp-twilio-api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "test": "jest --silent",
    "start": "node ./bundle-code.mjs --start",
    "build": "node ./bundle-code.mjs",
    "build:ci": "tsc --noEmit && node ./bundle-code.mjs",
    "deploy": "yarn build:ci && twilio-run deploy",
    "deploy-prod": "yarn build:ci && twilio-run deploy --verbose -l debug --production "
  },
  "dependencies": {
    "@twilio/runtime-handler": "2.0.1",
    "@zingdev/serverless-helpers": "^2.1.1",
    "twilio": "5.2.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@twilio-labs/serverless-runtime-types": "4.0.1",
    "@types/jest": "^29.2.4",
    "jest": "^29.3.1",
    "shared": "workspace:*",
    "ts-jest": "^29.0.3",
    "twilio-run": "^4.2.0"
  }
}
